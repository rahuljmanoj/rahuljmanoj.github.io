	title = {Variation in {Pulse} {Contour} {Markers} on an {Anesthetized} {Porcine} {During} {Pressure} {Perturbation}: {Association} with {Local} and {Regional} {Stiffness}},
	copyright = {https://doi.org/10.15223/policy-029},
