@inproceedings{sudarsan_feasibility_2024,
	address = {Orlando, FL, USA},
	title = {A {Feasibility} {Study} on the {Response} of {Vascular} {Impedance} to {Reactive} {Hyperemia}},
	copyright = {https://doi.org/10.15223/policy-029},
