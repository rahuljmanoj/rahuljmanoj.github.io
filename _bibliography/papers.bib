	title = {Continuous {Weight} {Monitoring} {System} for {ICU} {Beds} using {Air}-filled {Mattresses}/{Pads}: {A} {Proof} of {Concept}},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
